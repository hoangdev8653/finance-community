# ============================================================================
# FINANCE COMMUNITY PLATFORM - API ENVIRONMENT VARIABLE TEMPLATE
# ============================================================================

# 1. SERVER & CORS CONFIGURATION
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# 2. LOCAL NATIVE JWT SECURITY
# Chuỗi mã hóa bí mật ngẫu nhiên cho Native JWT Token
JWT_SECRET=super_secret_local_jwt_key_finance_community_2026_x9k2m

# 3. POSTGRESQL DATABASE CONFIGURATION
# Kết nối PostgreSQL Local hoặc Cloud (Supabase / Neon / Render)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONN_TIMEOUT_MS=5000
DATABASE_SSL=false

# 4. GOOGLE OAUTH 2.0 CREDENTIALS
# Lấy từ Google Cloud Console (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=225699815882-1mlk7q74m7o5git293vuq4dadjdo4cln.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=G0CSPX-pRCNH8DfLOTLDszTqAeTSG6dPkw

# 5. CLOUDINARY MEDIA STORAGE CREDENTIALS
# Lấy từ Cloudinary Dashboard (cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. EXTERNAL SUPABASE AUTH (OPTIONAL - NẾU CẦN DÙNG)
SUPABASE_URL=https://mock-project.supabase.co

# ============================================================================
# 7. ROADMAP INTEGRATIONS & THIRD-PARTY SERVICES
# ============================================================================

# Bảng giá thị trường thời gian thực (TCBS / VNDirect / Binance)
MARKET_DATA_PROVIDER=tcbs
MARKET_DATA_API_URL=https://apipubaws.tcbs.com.vn/stock-insight/v1/stock/bars-long-term
BINANCE_API_URL=https://api.binance.com

# AI Studio & News Curation (Lấy API Key tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Đăng nhập 1-chạm Facebook (Lấy tại https://developers.facebook.com)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback

# Automated news curation across Money, Business, Technology, Career, Life, and Sports.
# Keep source attribution and follow each publisher's RSS reuse terms.
NEWS_CURATOR_ENABLED=true
# NEWS_RSS_FEEDS is kept for older scripts that only accept a comma-separated URL list.
# NEWS_RSS_SOURCE_REGISTRY is the preferred structured registry for multi-domain/topic ingest.
NEWS_RSS_FEEDS=https://cafef.vn/thi-truong-chung-khoan.rss,https://cafef.vn/tai-chinh-ngan-hang.rss,https://cafef.vn/doanh-nghiep.rss,https://cafef.vn/bat-dong-san.rss,https://vneconomy.vn/tai-chinh.rss,https://vnexpress.net/rss/kinh-doanh.rss,https://vnexpress.net/rss/bat-dong-san.rss,https://cointelegraph.com/rss,https://thanhnien.vn/rss/kinh-te.rss,https://thanhnien.vn/rss/kinh-te/doanh-nghiep.rss,https://tuoitre.vn/rss/kinh-doanh.rss,https://vnexpress.net/rss/khoa-hoc-cong-nghe.rss,https://tuoitre.vn/rss/cong-nghe.rss,https://thanhnien.vn/rss/cong-nghe.rss,https://vnexpress.net/rss/giao-duc.rss,https://thanhnien.vn/rss/thoi-su/lao-dong-viec-lam.rss,https://thanhnien.vn/rss/gioi-tre/co-hoi-nghe-nghiep.rss,https://vnexpress.net/rss/doi-song.rss,https://vnexpress.net/rss/suc-khoe.rss,https://thanhnien.vn/rss/doi-song.rss,https://vnexpress.net/rss/the-thao.rss,https://tuoitre.vn/rss/the-thao.rss,https://thanhnien.vn/rss/the-thao.rss
