Ref: learning_series.outcomes_media_id > media.id
Ref: learning_series.cta_media_id > media.id
Ref: learning_series.domain_id > domains.id
Ref: learning_series.category_id > categories.id
Ref: learning_series.created_by > users.id
Ref: learning_series_posts.series_id > learning_series.id
Ref: learning_series_posts.post_id > posts.id
