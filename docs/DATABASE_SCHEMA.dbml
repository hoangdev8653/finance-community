Ref: follows.following_id > users.id
Ref: post_bookmarks.user_id > users.id
Ref: post_bookmarks.post_id > posts.id
Ref: notifications.user_id > users.id
Ref: notifications.reference_post_id > posts.id
Ref: notifications.reference_comment_id > comments.id
Ref: notifications.reference_user_id > users.id
